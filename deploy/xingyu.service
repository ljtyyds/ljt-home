[Unit]
Description=Xingyu Personal Portal
After=network.target
[Service]
Type=simple
User=xingyu
Group=xingyu
WorkingDirectory=/srv/xingyu/current
EnvironmentFile=/etc/xingyu.env
Environment=PATH=/opt/ljt-node/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/ljt-node/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/xingyu /srv/xingyu/current/.next/cache
[Install]
WantedBy=multi-user.target
