{
  "name": "xingyu-personal-portal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup.ts",
    "backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup.ts",
    "test": "tsx --test tests/core.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.61.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.64.1",
    "tsx": "4.23.15"
  },
  "type": "module"
}